# EXCEL STYLING HELPERS
# =============================================================================

FONT_NAME = "Arial"

TITLE_FONT = Font(name=FONT_NAME, size=16, bold=True, color="FFFFFF")
TITLE_FILL = PatternFill("solid", fgColor="1F4E78")
SUBTITLE_FONT = Font(name=FONT_NAME, size=9, italic=True, color="FFFFFF")

SECTION_FONT = Font(name=FONT_NAME, size=11, bold=True, color="FFFFFF")
SECTION_FILL = PatternFill("solid", fgColor="2E75B6")

HEADER_FONT = Font(name=FONT_NAME, size=9, bold=True, color="FFFFFF")
HEADER_FILL = PatternFill("solid", fgColor="4472C4")

DATA_FONT = Font(name=FONT_NAME, size=9)
BAND_FILL = PatternFill("solid", fgColor="EAF0FB")
THIN_BOTTOM = Border(bottom=Side(style="thin", color="BFBFBF"))

CENTER = Alignment(horizontal="center", vertical="center")
LEFT = Alignment(horizontal="left", vertical="center")


def write_section(ws, df, start_row, start_col, title, note, col_formats, pct_cols, col_widths):
    """Writes a titled, formatted table starting at (start_row, start_col).
    pct_cols: column names whose values are 0-100 and should be stored as
    Excel fractions (divided by 100) with a % number format.
    Returns dict with layout info needed to attach a chart.
    """
    n_cols = len(df.columns)

    # Section title bar
    title_row = start_row
    ws.merge_cells(start_row=title_row, start_column=start_col, end_row=title_row, end_column=start_col + n_cols - 1)
    tcell = ws.cell(row=title_row, column=start_col, value=title)
    tcell.font = SECTION_FONT
    tcell.fill = SECTION_FILL
    tcell.alignment = LEFT

    # Note row (methodology one-liner)
    note_row = title_row + 1
    ws.merge_cells(start_row=note_row, start_column=start_col, end_row=note_row, end_column=start_col + n_cols - 1)
    ncell = ws.cell(row=note_row, column=start_col, value=note)
    ncell.font = Font(name=FONT_NAME, size=8, italic=True, color="595959")
    ncell.alignment = LEFT

    # Header row
    header_row = note_row + 1
    for j, col in enumerate(df.columns):
        c = ws.cell(row=header_row, column=start_col + j, value=col.replace("_", " "))
        c.font = HEADER_FONT
        c.fill = HEADER_FILL
        c.alignment = CENTER
        c.border = THIN_BOTTOM

    # Data rows
    first_data_row = header_row + 1
    for i, (_, row) in enumerate(df.iterrows()):
        r = first_data_row + i
        for j, col in enumerate(df.columns):
            val = row[col]
            if col in pct_cols and pd.notna(val):
                val = val / 100.0
            c = ws.cell(row=r, column=start_col + j, value=val)
            c.font = DATA_FONT
            c.alignment = CENTER
            if col in col_formats:
                c.number_format = col_formats[col]
            if i % 2 == 1:
                c.fill = BAND_FILL

    last_data_row = first_data_row + len(df) - 1

    # Column widths — sections stack vertically and share the same physical
    # columns, so take the max width requested by any section for a given
    # column letter rather than letting the last-written section win.
    for j, col in enumerate(df.columns):
        letter = get_column_letter(start_col + j)
        wanted = col_widths.get(col, 14)
        current = ws.column_dimensions[letter].width
        if current is None or wanted > current:
            ws.column_dimensions[letter].width = wanted

    return {
        "header_row": header_row,
        "first_data_row": first_data_row,
        "last_data_row": last_data_row,
        "end_row": last_data_row + 1,  # blank spacer row
        "n_cols": n_cols,
    }


def write_summary_block(ws, summary: dict, start_row, start_col, title, value_formats=None, n_value_cols=3):
    """Writes a compact label/value summary card, e.g. index-level totals."""
    value_formats = value_formats or {}

    ws.merge_cells(start_row=start_row, start_column=start_col, end_row=start_row, end_column=start_col + n_value_cols)
    tcell = ws.cell(row=start_row, column=start_col, value=title)
    tcell.font = SECTION_FONT
    tcell.fill = SECTION_FILL
    tcell.alignment = LEFT

    row = start_row + 1
    for label, value in summary.items():
        lcell = ws.cell(row=row, column=start_col, value=label)
        lcell.font = Font(name=FONT_NAME, size=9, bold=True)
        lcell.fill = BAND_FILL
        vcell = ws.cell(row=row, column=start_col + 1, value=value)
        vcell.font = DATA_FONT
        vcell.alignment = CENTER
        if label in value_formats:
            vcell.number_format = value_formats[label]
        row += 1

    ws.column_dimensions[get_column_letter(start_col)].width = 36
    ws.column_dimensions[get_column_letter(start_col + 1)].width = 22

    return {"end_row": row}


def _rotate_labels(axis, angle_deg=-45, size=800):
    """Rotate an axis's category labels so long names don't overlap."""
    axis.txPr = RichText(
        bodyPr=RichTextProperties(rot=int(angle_deg * 60000), vert="horz"),
        p=[Paragraph(pPr=ParagraphProperties(defRPr=CharacterProperties(sz=size)),
                     endParaRPr=CharacterProperties(sz=size))],
    )


def add_bar_chart(ws, anchor, title, y_title, cat_col, val_col, min_row, max_row, start_col,
                   height=9, width=17, num_fmt="#,##0", rotate_labels=True):
    chart = BarChart()
    chart.type = "col"  # vertical columns
    chart.style = 10
    chart.title = title
    chart.y_axis.title = y_title
    chart.x_axis.title = None
    chart.legend = None
    chart.height = height
    chart.width = width
    chart.gapWidth = 40

    cats = Reference(ws, min_col=start_col + cat_col, min_row=min_row, max_row=max_row)
    vals = Reference(ws, min_col=start_col + val_col, min_row=min_row - 1, max_row=max_row)  # include header for series name
    chart.add_data(vals, titles_from_data=True)
    chart.set_categories(cats)

    # single, compact value-only data label above each column
    chart.dataLabels = DataLabelList()
    chart.dataLabels.showVal = True
    chart.dataLabels.showCatName = False
    chart.dataLabels.showSerName = False
    chart.dataLabels.showLegendKey = False
    chart.dataLabels.showPercent = False
    chart.dataLabels.numFmt = num_fmt

    # data is already sorted highest-to-lowest; for a column chart the default
    # category order (minMax) already places the first (largest) category on
    # the left, so no axis reversal is needed here (unlike horizontal bars).
    chart.x_axis.delete = False
    chart.y_axis.delete = False

    if rotate_labels:
        _rotate_labels(chart.x_axis)

    ws.add_chart(chart, anchor)


def add_dual_axis_bar_chart(ws, anchor, title, cat_col, lhs_col, rhs_col, min_row, max_row, start_col,
                             lhs_name, rhs_name, lhs_y_title, rhs_y_title,
                             height=11, width=22, rotate_labels=False):
    """Clustered column chart with the second series plotted as columns on a
    secondary (right-hand) y-axis, since the two series (e.g. CCC-and-below
    face value vs. full-index face value) sit on very different scales. Built
    as two BarChart objects combined via openpyxl's '+=' combo-chart pattern.
    Note: this workflow's own preview tool (LibreOffice) doesn't draw the
    right-hand axis line/labels for bar-on-bar dual-axis combos even when the
    underlying XML is correct (verified directly: two valAx elements, correct
    axPos/crosses, not deleted, category refs present on both series) — this
    is a known renderer limitation, not a file defect, and should display
    correctly with a visible right-hand axis in Microsoft Excel."""
    cats = Reference(ws, min_col=start_col + cat_col, min_row=min_row, max_row=max_row)

    # Primary (left-hand axis): CCC-and-below, as columns
    c1 = BarChart()
    c1.type = "col"
    c1.style = 10
    c1.title = title
    c1.gapWidth = 60
    c1.overlap = -10
    lhs_vals = Reference(ws, min_col=start_col + lhs_col, min_row=min_row - 1, max_row=max_row)
    c1.add_data(lhs_vals, titles_from_data=True)
    c1.set_categories(cats)
    c1.series[0].tx = SeriesLabel(v=f"{lhs_name} (LHS)")
    c1.y_axis.title = lhs_y_title
    c1.x_axis.title = None
    c1.x_axis.axPos = "b"
    c1.y_axis.axPos = "l"
    c1.y_axis.axId = 100
    c1.x_axis.delete = False
    c1.y_axis.delete = False

    # Secondary (right-hand axis): full index, also as columns
    c2 = BarChart()
    c2.type = "col"
    c2.gapWidth = 60
    c2.overlap = -10
    rhs_vals = Reference(ws, min_col=start_col + rhs_col, min_row=min_row - 1, max_row=max_row)
    c2.add_data(rhs_vals, titles_from_data=True)
    c2.set_categories(cats)  # every series needs its own category reference — easy to miss when combining charts
    c2.series[0].tx = SeriesLabel(v=f"{rhs_name} (RHS)")
    c2.y_axis.axId = 200
    c2.y_axis.axPos = "r"  # secondary axis must be explicitly pinned to the right side
    c2.y_axis.title = rhs_y_title
    c2.y_axis.crosses = "max"  # anchor the secondary axis on the right edge of the plot
    c2.y_axis.delete = False  # axis.delete defaults to hidden if left unset — must be explicit

    c1.y_axis.crosses = "autoZero"
    c1 += c2  # combine into one chart with two axes

    c1.legend.position = "b"
    c1.height = height
    c1.width = width

    if rotate_labels:
        _rotate_labels(c1.x_axis)

    ws.add_chart(c1, anchor)


