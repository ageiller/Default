RATING_BUCKET = {
    "AAA": "Other (IG)", "AA1": "Other (IG)", "AA2": "Other (IG)", "AA3": "Other (IG)",
    "A1": "Other (IG)", "A2": "Other (IG)", "A3": "Other (IG)",
    "BBB1": "Other (IG)", "BBB2": "Other (IG)", "BBB3": "Other (IG)",
    "BB1": "BB", "BB2": "BB", "BB3": "BB",
    "B1": "B", "B2": "B", "B3": "B",
    "CCC1": "CCC", "CCC2": "CCC", "CCC3": "CCC",
    "CC": "CC", "C": "C", "D": "D",
}
RATING_BUCKET_ORDER = ["BB", "B", "CCC", "CC", "C", "D", "Other (IG)"]


def _load_index(path: str) -> pd.DataFrame:
    df = pd.read_excel(path, sheet_name=0, header=1)
    df = df.dropna(subset=["Ticker"]).copy()
    df["rating_rank"] = df["Rating"].map(RATING_RANK)
    return df


def _index_as_of_label(path: str) -> str:
    """The source file's title row (e.g. 'H0A0 for 08/04/2026') carries the
    index's as-of date; pull it from row 1 rather than hardcoding it."""
    raw = pd.read_excel(path, sheet_name=0, header=None, nrows=1)
    return str(raw.iat[0, 0]).strip()


def build_index_summary(path: str) -> dict:
    df = _load_index(path)
    summary = {
        "Index / As-of Date": _index_as_of_label(path),
        "Total Face Value ($mm)": df["Face Value_LOC"].sum(),
        "Number of Issuers": df["Ticker"].nunique(),
        "Number of Bonds": len(df),
        "Wtd Avg Price": _wavg_mv(df, "Price"),
        "Wtd Avg OAS (bps)": _wavg_mv(df, "OAS"),
        "Wtd Avg Yield to Worst": _wavg_mv(df, "Yield to Worst (s.a.)") / 100.0,
        "Wtd Avg Effective Duration (yrs)": _wavg(df, "Effective Duration"),
    }
    return summary


def build_rating_bucket_table(path: str) -> pd.DataFrame:
    df = _load_index(path)
    df["Bucket"] = df["Rating"].map(RATING_BUCKET).fillna("Other")
    total_fv = df["Face Value_LOC"].sum()

    rows = []
    for bucket, g in df.groupby("Bucket"):
        fv = g["Face Value_LOC"].sum()
        rows.append(
            {
                "Rating Bucket": bucket,
                "N_Issuers": g["Ticker"].nunique(),
                "N_Bonds": len(g),
                "Total_FaceValue": fv,
                "Pct_of_Index": 100 * fv / total_fv,
            }
        )
    table = pd.DataFrame(rows)
    order = {b: i for i, b in enumerate(RATING_BUCKET_ORDER)}
    table["_order"] = table["Rating Bucket"].map(lambda b: order.get(b, 99))
    return table.sort_values("_order").drop(columns="_order").reset_index(drop=True)


def build_sector_size_table(path: str) -> pd.DataFrame:
    """Sector exposure sorted by size (largest first) — a composition view,
    distinct from the distress-sorted sector tables on the Overview sheet."""
    df = _load_index(path)
    total_fv = df["Face Value_LOC"].sum()

    rows = []
    for sector, g in df.groupby("Industry Lvl 3 Desc"):
        fv = g["Face Value_LOC"].sum()
        rows.append(
            {
                "Sector": sector,
                "N_Issuers": g["Ticker"].nunique(),
                "N_Bonds": len(g),
                "Total_FaceValue": fv,
                "Pct_of_Index": 100 * fv / total_fv,
                "Wavg_OAS": _wavg_mv(g, "OAS"),
            }
        )
    return pd.DataFrame(rows).sort_values("Total_FaceValue", ascending=False).reset_index(drop=True)


def build_top_issuers_table(path: str, top_n: int = 5) -> pd.DataFrame:
    """Largest issuers in the index by face value (position size, not distress)."""
    df = _load_index(path)
    total_fv = df["Face Value_LOC"].sum()

    rows = []
    for ticker, g in df.groupby("Ticker"):
        fv = g["Face Value_LOC"].sum()
        rows.append(
            {
                "Ticker": ticker,
                "Description": g["Description"].mode().iat[0],
                "Sector": g["Industry Lvl 3 Desc"].mode().iat[0],
                "N_Bonds": len(g),
                "Total_FaceValue": fv,
                "Pct_of_Index": 100 * fv / total_fv,
                "Best_Rating": g.loc[g["rating_rank"].idxmin(), "Rating"],
                "Wavg_OAS": _wavg_mv(g, "OAS"),
            }
        )
    table = pd.DataFrame(rows).sort_values("Total_FaceValue", ascending=False).head(top_n).reset_index(drop=True)
    return table


def build_subordination_table(path: str) -> pd.DataFrame:
    df = _load_index(path)
    total_fv = df["Face Value_LOC"].sum()

    rows = []
    for sub_type, g in df.groupby(df["Subordination Type"].astype(str).str.strip()):
        fv = g["Face Value_LOC"].sum()
        rows.append(
            {
                "Subordination Type": sub_type,
                "N_Bonds": len(g),
                "Total_FaceValue": fv,
                "Pct_of_Index": 100 * fv / total_fv,
            }
        )
    return pd.DataFrame(rows).sort_values("Total_FaceValue", ascending=False).reset_index(drop=True)


