def write_methodology_sheet(ws, us_index_path, us_default_path, eur_index_path, eur_default_path,
                             months_back, region_oas):
    ws.sheet_view.showGridLines = False
    ws.column_dimensions["A"].width = 110

    def title(text, row, size=14, fill="1F4E78"):
        c = ws.cell(row=row, column=1, value=text)
        c.font = Font(name=FONT_NAME, size=size, bold=True, color="FFFFFF")
        c.fill = PatternFill("solid", fgColor=fill)
        return row + 1

    def heading(text, row):
        c = ws.cell(row=row, column=1, value=text)
        c.font = Font(name=FONT_NAME, size=12, bold=True, color="1F4E78")
        return row + 1

    def para(text, row, bold=False):
        c = ws.cell(row=row, column=1, value=text)
        c.font = Font(name=FONT_NAME, size=10, bold=bold)
        c.alignment = Alignment(wrap_text=True, vertical="top")
        ws.row_dimensions[row].height = max(15, 15 * (len(text) // 130 + 1))
        return row + 1

    r = 1
    r = title("Methodology & Data Notes", r, size=16)
    r += 1
    r = para(f"Generated: {datetime.today().strftime('%Y-%m-%d')}   |   Sources: {us_index_path}, {us_default_path}, "
             f"{eur_index_path}, {eur_default_path}   |   Analysis uses ONLY these four files — no external or web data.",
             r, bold=True)
    r += 1

    r = heading("General approach", r)
    r = para("All figures are computed directly from the four source workbooks with pandas/openpyxl. Nothing is "
             "estimated, forecast, or pulled from outside sources. The same analytical logic is applied "
             "independently to the US index (H0A0) and the EUR index (HE00) — each region's 'index' sheet is "
             "built only from that region's index file, and each region's 'default' sheet only from that region's "
             "defaulted-bonds file. Every table is a snapshot as of the 'as of' date embedded in each index file "
             "and the run date above — re-running the script on updated source files will refresh all numbers.", r)
    r += 1

    r = heading("Workbook layout", r)
    r = para("Five sheets, one per source file plus this one: 'US Index' (from US_Index.xlsx), 'US default' "
             "(from US_default.xlsx), 'EUR index' (from EUR_Index.xlsx), 'EUR default' (from EUR_default.xlsx), "
             "and 'Methodologie' (this sheet, shared across both regions).", r)
    r += 1

    r = heading("'US Index' / 'EUR index' sheets — sections", r)
    r = para("Each index sheet is built entirely from that region's current index-composition file (one row per "
             "bond) and contains, top to bottom:", r)
    r = para("Index Summary — total face value, issuer/bond counts, and market-value-weighted price, OAS, and "
             "yield to worst (plus face-value-weighted effective duration) for the whole index.", r)
    r = para("Rating Bucket Distribution — face value and % of index by rating bucket (BB / B / CCC / CC / C / D), "
             "ordered by seniority.", r)
    r = para("Issuer Distress Ranking (Top 10) — a MARKET-IMPLIED distress screen, not a fundamental credit model: "
             "there is no balance-sheet or leverage data in these files, so it captures what bond investors are "
             "already pricing in via rating, price, and spread, not an independent forecast. Four bond-level "
             "inputs — rating rank (BB1=2 safest ... D=13 defaulted), Price, OAS, and Yield to Worst — are each "
             "standardized to a z-score across all bonds in that region's index (price and rating sign-flipped so "
             "higher always means more distressed), then averaged into a bond-level distress score. Bonds are "
             "grouped by Ticker (issuer level); Price/OAS/YTW are market-value-weighted averages (weighted by "
             "'% Mkt Value'), while the distress score and Total Face Value stay face-value-weighted — see 'A note "
             "on weighting' below. Issuers ranked highest to lowest distress score.", r)
    r = para("Sector Exposure & Distress Concentration — grouped by 'Industry Lvl 3 Desc'. An issue is 'CCC or "
             "below' if its rating rank >= 8. 'Pct Sector CCC or below' = face value of the sector's CCC-or-below "
             "bonds / total sector face value (face-value-weighted exposure ratio). OAS and YTW are market-value-"
             "weighted averages across all bonds in the sector. Sorted high-to-low by %CCC-or-below.", r)
    r = para("Sector Distress by Spread (OAS > 1,000bps) — a SECOND, independent distress definition: an issue is "
             "flagged distressed here if its OAS >= 1,000bps, regardless of agency rating. Same sector grouping. "
             "Cross-check against the rating-based view above: a sector can rank high on one and lower on the "
             "other when the market is pricing in more (or less) risk than ratings have recognized yet.", r)
    r = para("Sector Exposure (by Size) — same sector grouping, but sorted by face value (largest first) rather "
             "than by distress: a pure composition view, with market-value-weighted OAS per sector.", r)
    r = para("Country Exposure (by Size) — EUR INDEX SHEET ONLY. Grouped by 'ISO Country Code' (country of risk "
             "of the issuing entity), sorted by face value (largest first). Shows each country's share of the "
             "index by face value (composition view, not distress), plus market-value-weighted OAS per country.", r)
    r = para("Top 5 Issuers (by Face Value) — the five largest issuers by position size (not distress); 'Best "
