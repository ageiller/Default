    r = para("Subordination Type Breakdown — face value and % of index by Subordination Type (Senior / Secured / "
             "Subordinated / etc.), sorted high-to-low by face value.", r)
    r = para("Maturity Wall — Full Index — grouped by the calendar year of Maturity Date: number of issuers and "
             "face value maturing that year, and that year's face value as a % of the whole index's total face "
             "value. This is the only table on the sheet sorted CHRONOLOGICALLY (by year, ascending) rather than "
             "by size — a maturity timeline only makes sense read in calendar order.", r)
    r += 1

    r = heading("'US default' / 'EUR default' sheets — sections", r)
    r = para("Each default sheet is built entirely from that region's defaulted-bonds file (bonds removed from the "
             "index due to default, one row per bond) and contains, top to bottom:", r)
    r = para(f"Top Defaulted Issuers (last {months_back} months) — filter: 'Date Removed' >= today minus "
