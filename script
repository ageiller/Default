    r = para("• US and EUR results are NOT directly comparable in absolute currency terms without care: "
             "Face Value_LOC is in local currency (USD for the US index, EUR for the EUR index), while "
             "Face Value_USD in the default files is already converted to USD for both regions. OAS, yield, and "
             "duration are comparable in level terms but reflect different underlying government curves (US "
             "Treasuries vs. Euro-area government bonds).", r)
    r = para("• No data outside the four source files was used anywhere in this workbook.", r)


# =============================================================================
# MAIN
# =============================================================================

def main():
    parser = argparse.ArgumentParser(description="Build a two-region (US + EUR) HY distress dashboard workbook.")
    parser.add_argument("--us-index", default="US_Index.xlsx")
    parser.add_argument("--us-default", default="US_default.xlsx")
    parser.add_argument("--eur-index", default="EUR_Index.xlsx")
    parser.add_argument("--eur-default", default="EUR_default.xlsx")
    parser.add_argument("--months-back", type=int, default=12)
    parser.add_argument("--output", default="distress_analysis_US_EUR.xlsx")
    args = parser.parse_args()

    wb = Workbook()
    wb.remove(wb.active)  # drop the default blank sheet; we create named ones explicitly

    us_stats = build_index_sheet(wb, "US Index", args.us_index, "US")
    build_default_sheet(wb, "US default", args.us_default, "US", months_back=args.months_back)
    eur_stats = build_index_sheet(wb, "EUR index", args.eur_index, "EUR", include_country_table=True)
    build_default_sheet(wb, "EUR default", args.eur_default, "EUR", months_back=args.months_back)

    ws_meth = wb.create_sheet("Methodologie")
    region_oas = {
        "US": (us_stats["fv_oas"], us_stats["mv_oas"]),
        "EUR": (eur_stats["fv_oas"], eur_stats["mv_oas"]),
    }
    write_methodology_sheet(ws_meth, args.us_index, args.us_default, args.eur_index, args.eur_default,
                             args.months_back, region_oas)

    wb.save(args.output)
    print(f"Saved: {args.output}")


if __name__ == "__main__":
    main()
