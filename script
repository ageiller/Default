def build_default_sheet(wb, sheet_name, defaulted_path, region_label, months_back=12):
    """Everything derivable from ONE defaulted-bonds file: top defaulted
    issuers (last N months) and historical defaults by sector (full
    history)."""
    ws = wb.create_sheet(sheet_name)
    ws.sheet_view.showGridLines = False

    ws.merge_cells("A1:P1")
    t = ws.cell(row=1, column=1, value=f"ICE BofA {region_label} High Yield Index — Default History")
    t.font = TITLE_FONT
    t.fill = TITLE_FILL
    t.alignment = LEFT
    ws.merge_cells("A2:P2")
    s = ws.cell(row=2, column=1, value=f"Generated {datetime.today().strftime('%Y-%m-%d')}  |  Source: "
                                        f"{defaulted_path}  |  Data-only, no external sources")
    s.font = Font(name=FONT_NAME, size=9, italic=True, color="1F4E78")
    ws.row_dimensions[1].height = 22

    row = 4

    # --- Top defaulted issuers, last N months + chart ---
    defaulted = build_defaulted_table(defaulted_path, months_back, top_n=10)
    fmt1 = {"Total_FaceValue_USD_mm": "#,##0.0", "Last_Removal_Date": "yyyy-mm-dd"}
    widths1 = {"Ticker": 10, "Description": 42, "Sector": 16, "N_Bonds": 9, "Total_FaceValue_USD_mm": 16,
               "Last_Removal_Date": 14, "Worst_Rating": 11}
    info1 = write_section(
        ws, defaulted, row, LEFT_COL,
        f"Top Defaulted Issuers — Last {months_back} Months (by Face Value)",
        f"Filter: Date Removed >= today - {months_back}mo | Grouped by issuer | Sorted high-to-low",
        fmt1, pct_cols=set(), col_widths=widths1,
    )
    cat_idx = list(defaulted.columns).index("Ticker")
    val_idx = list(defaulted.columns).index("Total_FaceValue_USD_mm")
    add_bar_chart(
        ws, f"{get_column_letter(CHART_COL)}{row}",
        "Top Defaulted Issuers — Face Value ($mm)", "$mm",
        cat_idx, val_idx, info1["first_data_row"], info1["last_data_row"], LEFT_COL,
        height=10, width=18, num_fmt="#,##0", rotate_labels=False,
    )
    row = max(info1["end_row"], row + 22) + 3

    # --- Historical defaults by sector, full history + chart ---
    sector_history = build_sector_default_history(defaulted_path)
    fmt5 = {"Total_FaceValue_USD_mm": "#,##0.0", "Avg_Price_on_Removal": "0.00"}
    widths5 = {"Sector": 24, "N_Defaults": 12, "Total_FaceValue_USD_mm": 18, "Avg_Price_on_Removal": 16}
    info5 = write_section(
        ws, sector_history, row, LEFT_COL,
        "Historical Defaults by Sector — Full History",
        "No date filter (entire file) | Grouped by Industry Lvl 3 | Sorted high-to-low by face value",
        fmt5, pct_cols=set(), col_widths=widths5,
    )
    cat_idx = list(sector_history.columns).index("Sector")
    val_idx = list(sector_history.columns).index("Total_FaceValue_USD_mm")
    add_bar_chart(
        ws, f"{get_column_letter(CHART_COL)}{row}",
        "Historical Defaults — Total Face Value ($mm)", "$mm",
        cat_idx, val_idx, info5["first_data_row"], info5["last_data_row"], LEFT_COL,
        height=12, width=24, num_fmt="#,##0",
    )


