LEFT_COL = 1
CHART_COL = 10


def build_index_sheet(wb, sheet_name, index_path, region_label, include_country_table=False):
    """Everything derivable from ONE index file (current composition, one row
    per bond): index-level summary, rating buckets, issuer distress ranking,
    sector exposure & CCC concentration, sector distress by OAS, sector
    exposure by size, top 5 issuers, subordination breakdown, maturity wall."""
    ws = wb.create_sheet(sheet_name)
    ws.sheet_view.showGridLines = False

    ws.merge_cells("A1:P1")
    t = ws.cell(row=1, column=1, value=f"ICE BofA {region_label} High Yield Index — Distress & Composition Dashboard")
    t.font = TITLE_FONT
    t.fill = TITLE_FILL
    t.alignment = LEFT
    ws.merge_cells("A2:P2")
    s = ws.cell(row=2, column=1, value=f"Generated {datetime.today().strftime('%Y-%m-%d')}  |  Source: "
                                        f"{index_path}  |  Data-only, no external sources")
