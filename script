RATING_RANK = {
    "AAA": 0, "AA1": 0.5, "AA2": 0.5, "AA3": 0.5,
    "A1": 1, "A2": 1, "A3": 1,
    "BBB1": 1.5, "BBB2": 1.5, "BBB3": 1.5,
    "BB1": 2, "BB2": 3, "BB3": 4,
    "B1": 5, "B2": 6, "B3": 7,
    "CCC1": 8, "CCC2": 9, "CCC3": 10,
    "CC": 11, "C": 12, "D": 13,
}

RATING_BUCKET = {
    "AAA": "Other (IG)", "AA1": "Other (IG)", "AA2": "Other (IG)", "AA3": "Other (IG)",
    "A1": "Other (IG)", "A2": "Other (IG)", "A3": "Other (IG)",
    "BBB1": "Other (IG)", "BBB2": "Other (IG)", "BBB3": "Other (IG)",
    "BB1": "BB", "BB2": "BB", "BB3": "BB",
    "B1": "B", "B2": "B", "B3": "B",
    "CCC1": "CCC", "CCC2": "CCC", "CCC3": "CCC",
    "CC": "CC", "C": "C", "D": "D",
}
RATING_BUCKET_ORDER = ["BB", "B", "CCC", "CC", "C", "D", "Other (IG)"]


def _wavg(group: pd.DataFrame, col: str) -> float:
    """Face-value-weighted average — used for sizing/exposure metrics (totals,
    % of index, CCC-or-below ratios, distress-score aggregation, etc.)."""
    return np.average(group[col], weights=group["Face Value_LOC"])


def _wavg_mv(group: pd.DataFrame, col: str) -> float:
    """Market-value-weighted average — used specifically for OAS, Price, and
    Yield to Worst. Weighting by '% Mkt Value' (proportional to price x face
    value) rather than face value alone means deeply discounted distressed
    bonds — large face value but tiny dollar price — carry less weight, since
    they represent less actual dollar exposure in the index today."""
    return np.average(group[col], weights=group["% Mkt Value"])


# --- 1. Top defaulted issuers, last N months ---------------------------------
def build_defaulted_table(path: str, months_back: int = 12, top_n: int = 10) -> pd.DataFrame:
    df = pd.read_excel(path, sheet_name=0)
    cutoff = pd.Timestamp.today().normalize() - pd.DateOffset(months=months_back)
    recent = df[df["Date Removed"] >= cutoff].copy()

    table = (
        recent.groupby(["Ticker", "Description"], as_index=False)
        .agg(
            Sector=("Industry Lvl 3 Desc", "first"),
            N_Bonds=("Face Value_USD", "size"),
            Total_FaceValue_USD_mm=("Face Value_USD", "sum"),
            Last_Removal_Date=("Date Removed", "max"),
            Worst_Rating=("Rating Before Date Removed", lambda s: s.astype(str).str.strip().iloc[-1]),
        )
        .sort_values("Total_FaceValue_USD_mm", ascending=False)
        .head(top_n)
        .reset_index(drop=True)
    )
    return table


# --- 2. Issuer distress ranking, current index -------------------------------
def build_distress_table(path: str, top_n: int = 10) -> pd.DataFrame:
    df = pd.read_excel(path, sheet_name=0, header=1)
    df = df.dropna(subset=["Ticker"]).copy()
    df["rating_rank"] = df["Rating"].map(RATING_RANK)

    for col in ["rating_rank", "OAS", "Yield to Worst (s.a.)"]:
        df[f"{col}_z"] = (df[col] - df[col].mean()) / df[col].std()
    df["price_z"] = -(df["Price"] - df["Price"].mean()) / df["Price"].std()
    df["distress_score"] = df[
        ["rating_rank_z", "OAS_z", "Yield to Worst (s.a.)_z", "price_z"]
    ].mean(axis=1)

    rows = []
    for ticker, g in df.groupby("Ticker"):
        rows.append(
            {
                "Ticker": ticker,
                "Description": g["Description"].mode().iat[0],
                "Worst_Rating": g.loc[g["rating_rank"].idxmax(), "Rating"],
                "Total_FaceValue": g["Face Value_LOC"].sum(),
                "Wavg_Price": _wavg_mv(g, "Price"),
                "Wavg_OAS": _wavg_mv(g, "OAS"),
                "Wavg_YTW": _wavg_mv(g, "Yield to Worst (s.a.)"),
                "Distress_Score": _wavg(g, "distress_score"),
            }
        )

    issuer = pd.DataFrame(rows).sort_values("Distress_Score", ascending=False)
    return issuer.head(top_n).reset_index(drop=True)


# --- 3. Sector exposure & distress concentration, current index --------------
def build_sector_table(path: str) -> pd.DataFrame:
    df = pd.read_excel(path, sheet_name=0, header=1)
    df = df.dropna(subset=["Ticker"]).copy()
    df["rating_rank"] = df["Rating"].map(RATING_RANK)
    df["is_ccc_or_below"] = df["rating_rank"] >= 8

    total_fv = df["Face Value_LOC"].sum()
    rows = []
    for sector, g in df.groupby("Industry Lvl 3 Desc"):
        ccc = g[g["is_ccc_or_below"]]
        sector_fv = g["Face Value_LOC"].sum()
        rows.append(
            {
                "Sector": sector,
                "N_Issuers": g["Ticker"].nunique(),
                "Total_FaceValue": sector_fv,
                "Pct_of_Index": 100 * sector_fv / total_fv,
                "Wavg_OAS": _wavg_mv(g, "OAS"),
                "Wavg_YTW": _wavg_mv(g, "Yield to Worst (s.a.)"),
                "Pct_Sector_CCC_or_below": 100 * ccc["Face Value_LOC"].sum() / sector_fv if sector_fv else 0,
            }
        )
    return pd.DataFrame(rows).sort_values("Pct_Sector_CCC_or_below", ascending=False).reset_index(drop=True)


# --- 3b. Sector distress by spread (OAS > threshold bps), current index ------
def build_sector_oas_distress_table(path: str, oas_threshold: float = 1000) -> pd.DataFrame:
    df = pd.read_excel(path, sheet_name=0, header=1)
    df = df.dropna(subset=["Ticker"]).copy()
    df["is_wide_oas"] = df["OAS"] >= oas_threshold

    total_fv = df["Face Value_LOC"].sum()
    rows = []
    for sector, g in df.groupby("Industry Lvl 3 Desc"):
        wide = g[g["is_wide_oas"]]
        sector_fv = g["Face Value_LOC"].sum()
        rows.append(
            {
                "Sector": sector,
                "N_Issuers": g["Ticker"].nunique(),
                "N_Issuers_Distressed": wide["Ticker"].nunique(),
                "Total_FaceValue": sector_fv,
                "Pct_of_Index": 100 * sector_fv / total_fv,
                "FaceValue_OAS_over_Threshold": wide["Face Value_LOC"].sum(),
                "Pct_Sector_OAS_over_Threshold": 100 * wide["Face Value_LOC"].sum() / sector_fv if sector_fv else 0,
            }
        )
    return pd.DataFrame(rows).sort_values("Pct_Sector_OAS_over_Threshold", ascending=False).reset_index(drop=True)


# --- 4. Historical defaults by sector, full history ---------------------------
def build_sector_default_history(path: str) -> pd.DataFrame:
    df = pd.read_excel(path, sheet_name=0)
    table = (
        df.groupby("Industry Lvl 3 Desc")
        .agg(
            N_Defaults=("Face Value_USD", "size"),
            Total_FaceValue_USD_mm=("Face Value_USD", "sum"),
            Avg_Price_on_Removal=("Price on Removal Date", "mean"),
        )
        .sort_values("Total_FaceValue_USD_mm", ascending=False)
        .reset_index()
        .rename(columns={"Industry Lvl 3 Desc": "Sector"})
    )
    return table


# --- 5. Maturity wall: full index, current index -----------------------------
def build_maturity_wall(path: str) -> pd.DataFrame:
    """Whole-index maturity profile only (no CCC-and-below overlay)."""
    df = pd.read_excel(path, sheet_name=0, header=1)
    df = df.dropna(subset=["Ticker"]).copy()
    df["Maturity Date"] = pd.to_datetime(df["Maturity Date"])
    df["Maturity_Year"] = df["Maturity Date"].dt.year

    total_index_fv = df["Face Value_LOC"].sum()
    wall = df.groupby("Maturity_Year").agg(
        N_Issuers_Index=("Ticker", "nunique"), FaceValue_Index=("Face Value_LOC", "sum")
    ).reset_index()
    wall["Pct_of_Index"] = 100 * wall["FaceValue_Index"] / total_index_fv

    wall = wall[["Maturity_Year", "N_Issuers_Index", "FaceValue_Index", "Pct_of_Index"]]
    return wall.sort_values("Maturity_Year", ascending=True).reset_index(drop=True)


def _load_index(path: str) -> pd.DataFrame:
    df = pd.read_excel(path, sheet_name=0, header=1)
    df = df.dropna(subset=["Ticker"]).copy()
    df["rating_rank"] = df["Rating"].map(RATING_RANK)
    return df


def _index_as_of_label(path: str) -> str:
    raw = pd.read_excel(path, sheet_name=0, header=None, nrows=1)
    return str(raw.iat[0, 0]).strip()


def build_index_summary(path: str) -> dict:
    df = _load_index(path)
    summary = {
        "Index / As-of Date": _index_as_of_label(path),
        "Total Face Value ($mm)": df["Face Value_LOC"].sum(),
        "Number of Issuers": df["Ticker"].nunique(),
        "Number of Bonds": len(df),
        "Wtd Avg Price": _wavg_mv(df, "Price"),
        "Wtd Avg OAS (bps)": _wavg_mv(df, "OAS"),
        "Wtd Avg Yield to Worst": _wavg_mv(df, "Yield to Worst (s.a.)") / 100.0,
        "Wtd Avg Effective Duration (yrs)": _wavg(df, "Effective Duration"),
    }
    return summary


def build_rating_bucket_table(path: str) -> pd.DataFrame:
    df = _load_index(path)
    df["Bucket"] = df["Rating"].map(RATING_BUCKET).fillna("Other")
    total_fv = df["Face Value_LOC"].sum()

    rows = []
    for bucket, g in df.groupby("Bucket"):
        fv = g["Face Value_LOC"].sum()
        rows.append(
            {
                "Rating Bucket": bucket,
                "N_Issuers": g["Ticker"].nunique(),
                "N_Bonds": len(g),
                "Total_FaceValue": fv,
                "Pct_of_Index": 100 * fv / total_fv,
            }
        )
    table = pd.DataFrame(rows)
    order = {b: i for i, b in enumerate(RATING_BUCKET_ORDER)}
    table["_order"] = table["Rating Bucket"].map(lambda b: order.get(b, 99))
    return table.sort_values("_order").drop(columns="_order").reset_index(drop=True)


def build_sector_size_table(path: str) -> pd.DataFrame:
    df = _load_index(path)
    total_fv = df["Face Value_LOC"].sum()

    rows = []
    for sector, g in df.groupby("Industry Lvl 3 Desc"):
        fv = g["Face Value_LOC"].sum()
        rows.append(
            {
                "Sector": sector,
                "N_Issuers": g["Ticker"].nunique(),
                "N_Bonds": len(g),
                "Total_FaceValue": fv,
                "Pct_of_Index": 100 * fv / total_fv,
                "Wavg_OAS": _wavg_mv(g, "OAS"),
            }
        )
    return pd.DataFrame(rows).sort_values("Total_FaceValue", ascending=False).reset_index(drop=True)


def build_top_issuers_table(path: str, top_n: int = 5) -> pd.DataFrame:
    df = _load_index(path)
    total_fv = df["Face Value_LOC"].sum()

    rows = []
    for ticker, g in df.groupby("Ticker"):
        fv = g["Face Value_LOC"].sum()
        rows.append(
            {
                "Ticker": ticker,
                "Description": g["Description"].mode().iat[0],
                "Sector": g["Industry Lvl 3 Desc"].mode().iat[0],
                "N_Bonds": len(g),
                "Total_FaceValue": fv,
                "Pct_of_Index": 100 * fv / total_fv,
                "Best_Rating": g.loc[g["rating_rank"].idxmin(), "Rating"],
                "Wavg_OAS": _wavg_mv(g, "OAS"),
            }
        )
    table = pd.DataFrame(rows).sort_values("Total_FaceValue", ascending=False).head(top_n).reset_index(drop=True)
    return table


def build_country_table(path: str) -> pd.DataFrame:
    """Country exposure — grouped by 'ISO Country Code', sorted by size
    (largest first), analogous to build_sector_size_table but by country of
    risk rather than industry."""
    df = _load_index(path)
    total_fv = df["Face Value_LOC"].sum()

    rows = []
    for country, g in df.groupby("ISO Country Code"):
        fv = g["Face Value_LOC"].sum()
        rows.append(
            {
                "Country": country,
                "N_Issuers": g["Ticker"].nunique(),
                "N_Bonds": len(g),
                "Total_FaceValue": fv,
                "Pct_of_Index": 100 * fv / total_fv,
                "Wavg_OAS": _wavg_mv(g, "OAS"),
            }
        )
    return pd.DataFrame(rows).sort_values("Total_FaceValue", ascending=False).reset_index(drop=True)


def build_subordination_table(path: str) -> pd.DataFrame:
    df = _load_index(path)
    total_fv = df["Face Value_LOC"].sum()

    rows = []
    for sub_type, g in df.groupby(df["Subordination Type"].astype(str).str.strip()):
        fv = g["Face Value_LOC"].sum()
        rows.append(
            {
                "Subordination Type": sub_type,
                "N_Bonds": len(g),
                "Total_FaceValue": fv,
                "Pct_of_Index": 100 * fv / total_fv,
            }
        )
    return pd.DataFrame(rows).sort_values("Total_FaceValue", ascending=False).reset_index(drop=True)


